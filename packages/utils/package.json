{
  "name": "@nightout/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Pure domain logic shared by frontend and backend + Rest (HTTP client กลางของหน้าบ้าน: @nightout/utils/rest)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.js",
      "require": "./dist/rest.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/rest.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/rest.ts --format esm,cjs --dts --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nightout/types": "workspace:*",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@nightout/config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
