# Docker ignore file — excludes unnecessary files from build context
# Reduces image size and build time

# Git
.git
.gitignore
.gitattributes

# Node
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build/dist
dist/
build/
.next/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.env.local
.env.*.local

# Testing
coverage/
.nyc_output/
.mocha/
*.lcov

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Misc
README.md
LICENSE
docs/
.claude/
CLAUDE.md
CONTEXT.md
scripts/
.env.example
