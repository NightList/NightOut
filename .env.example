# ---- Frontend (apps/frontend, apps/admin) — Vite ต้องขึ้นต้นด้วย VITE_ · VITE_API_URL เดิมยังอ่านเป็นค่าสำรอง ----
# Supabase ในหน้าเว็บใช้เฉพาะ Auth (เข้าสู่ระบบ) — anon key เป็น publishable key · ห้ามใส่ service_role ใน VITE_* (ADR 0002)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# NestJS API — หน้าเว็บอ่าน/เขียนข้อมูลผ่านตัวนี้เท่านั้น (ว่าง: dev = http://localhost:3000/api, deploy = /api)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_TURNSTILE_SITE_KEY=
# แผนที่: ว่าง = OpenFreeMap vector · โหลดล้มเหลวใช้ OpenStreetMap raster สำรอง
# URL raster ที่กำหนดเองต้องใช้ public key ที่จำกัด domain เท่านั้น
VITE_MAP_TILE_URL_LIGHT=
VITE_MAP_TILE_URL_DARK=
VITE_MAP_TILE_ATTRIBUTION=
# เวลารอ vector ก่อนใช้ raster สำรอง (milliseconds)
VITE_MAP_LOAD_TIMEOUT_MS=15000

# ---- Backend (backend/api) ----
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# ใช้อ่านข้อมูลแทนหน้าเว็บโดยให้ RLS ทำงานตามสิทธิ์ผู้เรียก (ค่าเดียวกับ VITE_SUPABASE_ANON_KEY · ว่าง = ใช้ค่านั้น)
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
JOB_SECRET=change-me
QR_SIGNING_KEY=change-me
# เข้ารหัสเลขบัญชีร้าน (AES-256-GCM) — สุ่มยาว ≥ 16 ตัว, ห้ามเปลี่ยนหลังมีข้อมูลแล้ว
PAYOUT_ENCRYPTION_KEY=change-me-at-least-16-chars
LINE_CHANNEL_ACCESS_TOKEN=
