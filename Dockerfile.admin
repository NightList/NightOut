# NightOut Admin (React + Vite)
# Multi-stage build: dependencies → build → nginx serve

# Stage 1: Dependencies
FROM node:22-alpine AS dependencies
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@10.28.0

# Copy pnpm workspaces root
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy config, types, utils, ui, mock package.json files
COPY packages/config/package.json ./packages/config/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/ui/package.json ./packages/ui/
COPY packages/mock/package.json ./packages/mock/

# Copy backend, frontend, admin package.json files
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/
COPY apps/admin/package.json ./apps/admin/

# Install dependencies
RUN pnpm install

# Stage 2: Builder
FROM node:22-alpine AS builder
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@10.28.0

# Copy from dependencies
COPY --from=dependencies /app/node_modules ./node_modules

# Copy source
COPY . .

# Build all apps (admin depends on packages being built)
RUN pnpm build

# Stage 3: Runtime (nginx)
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy nginx config (admin ถูก build ด้วย base `/admin/` → ต้องมี location /admin/)
COPY --chown=nginx:nginx nginx.admin.conf /etc/nginx/nginx.conf

# Copy built dist from builder — admin ใช้ base `/admin/` จึงวางไฟล์ใต้ /admin
COPY --from=builder --chown=nginx:nginx /app/apps/admin/dist /usr/share/nginx/html/admin

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/index.html || exit 1

CMD ["nginx", "-g", "daemon off;"]
